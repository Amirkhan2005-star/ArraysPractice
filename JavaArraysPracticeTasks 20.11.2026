import java.util.Scanner;

public class JavaArraysPracticeTasks {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Task 1: Count positive, negative, and zero values
        int[] arr1 = {5, -3, 0, 8, -1, 0, 12, -7, 4, 2};
        int pos = 0;
        int neg = 0;
        int zero = 0;

        System.out.print("Array: ");
        for (int i = 0; i < arr1.length; i++) {
            System.out.print(arr1[i] + " ");

            if (arr1[i] > 0) {
                pos++;
            } else if (arr1[i] < 0) {
                neg++;
            } else {
                zero++;
            }
        }
        System.out.println();
        System.out.println("Positive: " + pos);
        System.out.println("Negative: " + neg);
        System.out.println("Zero: " + zero);

        System.out.println();

        // Task 2: Find the largest and smallest elements and their indices
        int[] arr2 = {12, 5, 28, 3, 19, 7, 15, 9};
        int max = arr2[0];
        int min = arr2[0];
        int maxIdx = 0;
        int minIdx = 0;

        System.out.print("Array: ");
        for (int i = 0; i < arr2.length; i++) {
            System.out.print(arr2[i] + " ");

            if (arr2[i] > max) {
                max = arr2[i];
                maxIdx = i;
            }
            if (arr2[i] < min) {
                min = arr2[i];
                minIdx = i;
            }
        }
        System.out.println();
        System.out.println("Largest: " + max + " at index " + maxIdx);
        System.out.println("Smallest: " + min + " at index " + minIdx);

        System.out.println();

        // Task 3: Count numbers strictly greater than the average
        int[] arr3 = {10, 20, 30, 40, 50, 60};
        int sum = 0;

        System.out.print("Array: ");
        for (int i = 0; i < arr3.length; i++) {
            System.out.print(arr3[i] + " ");
            sum += arr3[i];
        }

        double avg = (double) sum / arr3.length;
        int count = 0;

        for (int i = 0; i < arr3.length; i++) {
            if (arr3[i] > avg) {
                count++;
            }
        }
        System.out.println();
        System.out.println("Average: " + avg);
        System.out.println("Numbers above average: " + count);

        System.out.println();

        // Task 4: Print an array in reverse order without modifying it
        int[] arr4 = {3, 8, 12, 5, 9, 2, 7};

        System.out.print("Original: ");
        for (int i = 0; i < arr4.length; i++) {
            System.out.print(arr4[i] + " ");
        }

        System.out.print("\nReversed: ");
        for (int i = arr4.length - 1; i >= 0; i--) {
            System.out.print(arr4[i] + " ");
        }
        System.out.println();

        System.out.println();

        // Task 5: Enter student scores, then count passes and failures
        int[] scores = new int[5];
        int pass = 0;
        int fail = 0;
        int total = 0;

        for (int i = 0; i < scores.length; i++) {
            int score;

            while (true) {
                System.out.print("Enter score " + (i + 1) + " (0-100): ");

                if (sc.hasNextInt()) {
                    score = sc.nextInt();

                    if (score >= 0 && score <= 100) {
                        break;
                    }
                } else {
                    sc.next(); // Discard input that isn't an integer
                }

                System.out.println("Invalid score. Please enter a number from 0 to 100.");
            }

            scores[i] = score;
            total += score;

            if (score >= 60) {
                pass++;
            } else {
                fail++;
            }
        }

        double ans = (double) total / scores.length;

        System.out.print("\nScores: ");
        for (int i = 0; i < scores.length; i++) {
            System.out.print(scores[i] + " ");
        }
        System.out.println();
        System.out.println("Passed: " + pass);
        System.out.println("Failed: " + fail);
        System.out.println("Average: " + ans);

        sc.close();
    }
}
